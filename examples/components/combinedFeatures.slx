// A mix of the component features in one file: a generic component used as a
// named child, several named children at two nesting levels, methods in both
// body forms, and a method writing its own prop through `&mut self`. If any one
// of these regresses this file stops compiling.
component Money {
    pub prop cents: sint32 = 0;
}

component Cell<T> {
    pub prop value: T;

    pub func asInt(&self): sint32 {
        1
    }
}

component Row {
    amount=Money { cents: 250 }

    first=Cell<sint32> { value: 1 }
    second=Cell<sint32> { value: 2 }

    pub func count(&self): sint32 {
        self.first.asInt() + self.second.asInt()
    }

    pub func total(&self): sint32 -> self.amount.cents;
}

component Table {
    row=Row {}

    pub func grandTotal(&self): sint32 {
        self.row.total() + self.row.count()
    }

    pub func grow(&mut self): sint32 {
        self.row.count()
    }
}

func main(): sint32 {
    let mut table = Table {};
    table.grow();
    table.grandTotal()
}