component Counter {
    prop value: sint32;

    func new(): Self {
        Self { value: 0 }
    }

    func increment(&mut self, amount: sint32): void {
        self.value = self.value + amount;
    }

    func getValue(&self): sint32 {
        self.value
    }
}

func main(): void {
    let mut v = Counter.new();
    v.increment(5);
    let val = v.getValue();
}
