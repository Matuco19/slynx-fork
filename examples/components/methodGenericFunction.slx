// A method may declare its own type parameter. With `&self` as the first
// parameter, the call `counter.id(7)` infers `U = sint32` from the explicit
// argument and the monomorphizer instantiates the method for that type.
component Counter {
    pub prop value: sint32 = 0;

    pub func id<U>(&self, x: U): U {
        x
    }
}

func main(): sint32 {
    let counter = Counter {};
    counter.id(7)
}