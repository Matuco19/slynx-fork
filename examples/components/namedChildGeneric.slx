// A named child may be an instantiation of a generic component, with its type
// arguments written at the use site. The child must keep its specialized prop
// type, and the parent must be able to call a method on it and read its prop.
component Box<T> {
    pub prop item: T;

    pub func doubled(&self, n: sint32): sint32 {
        n * 2
    }

    pub func peek(&self): sint32 {
        self.item
    }
}

component Holder {
    first=Box<sint32> { item: 3 }
    second=Box<bool> { item: true }

    pub func viaMethod(&self): sint32 {
        self.first.doubled(4)
    }

    pub func viaProp(&self): sint32 -> self.first.item;
}

func main(): sint32 {
    let holder = Holder {};
    holder.viaMethod()
}