// Named children nest: a named child may itself declare named children, and the
// whole chain stays reachable through one method per level. Each level is a
// separate component type, so this also checks that the child's own type is used
// rather than the parent's.
component Leaf {
    pub prop value: sint32 = 1;

    pub func read(&self): sint32 {
        self.value
    }
}

component Branch {
    leaf=Leaf { value: 7 }

    pub func read(&self): sint32 {
        self.leaf.read()
    }
}

component Trunk {
    branch=Branch {}

    pub func readExpr(&self): sint32 -> self.branch.read();
}

func main(): sint32 {
    let trunk = Trunk {};
    trunk.readExpr()
}