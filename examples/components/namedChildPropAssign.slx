// Writing and reading a child's property through parent methods works.
// Emitting updates for the property's dependants is not modelled yet.
component Inner {
    pub prop value: sint32 = 0;
}

component Outer {
    inner=Inner {}

    pub func setChild(&mut self): void {
        self.inner.value = 7;
    }

    pub func readChild(&self): sint32 -> self.inner.value;
}

func main(): sint32 {
    let mut outer = Outer {};
    outer.setChild();
    outer.readChild()
}
