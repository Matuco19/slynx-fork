// xfail: a child cannot be replaced. children are not idealized for so, even though their properties might yes be able to replacing
component Kid {
    pub prop v: sint32 = 3;
}

component Parent {
    kid=Kid {}

    pub func replaceChild(&mut self): void {
        self.kid = Kid { v: 7 };
    }

    pub func readChild(&self): sint32 -> self.kid.v;
}

func main(): sint32 {
    let mut parent = Parent {};
    parent.replaceChild();
    parent.readChild()
}
