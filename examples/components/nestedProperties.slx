object StyleContext {
    paint: sint32,
}

object DrawingContext {
    scale: sint32,

    func render(&self, text: str, paint: sint32): void {
    }
}

component Text {
    prop text: str;
    prop style: StyleContext;

    func onMount(scene: sint32): void {
    }

    func render(&self, context: DrawingContext): void {
        context.render(self.text, self.style.paint);
    }
}

func main(): void {
    let text = Text {
        text: "hi",
        style: StyleContext(paint: 1)
    };
    Text.onMount(0);
    text.render(DrawingContext(scale: 2));
}
