// A generic struct field with a nullable type works: the field-access
// retyping added for indexed generic fields (see generics-fix.md §4) reads the
// field type from the specialized struct, so `data` becomes `sint32?` instead of a
// leftover `T?`.
import option using {Option};

object Box<T> {
    data: Option<T>
}

func main(): sint32 {
    let b = Box<sint32>(data: Option.Some(42));
    if b.data matches Some(42) {
        42
    }else {
        0
    }
}
