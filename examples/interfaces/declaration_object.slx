interface Stringifiable {
    func stringify(&self): str;
    func length(&self): sint32;
}

extend str: Stringifiable {
    func stringify(&self): str -> self;
    func length(&self): sint32 -> 0;
}

object Person: Stringifiable {
    name: str,
    func stringify(&self): str -> self.name;
    func length(&self): sint32 -> self.name.length();
}

func main(): void {
    let person = Person(name: "ada");
    person.stringify();
    person.length();
}
