func main(): void {
    let v = MyObj.staticFactory(0, "test");
    v.instanceMethod(42);
    let val = v.getValue();
}

pub object MyObj {
    value: sint32,
    name: str,

    func instanceMethod(&mut self, x: sint32): void {
        self.value = self.value + x;
    }

    func getValue(&self): sint32 {
        self.value
    }

    func staticFactory(x: sint32, s: str): Self {
        Self(value: x, name: s)
    }
}
